{
  "name": "vaultx",
  "version": "1.0.0",
  "description": "VaultX - 本地优先的跨平台密码管理工具",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main/index.js --sourcemap --external:electron --external:argon2",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.js --sourcemap --external:electron",
    "build:renderer": "esbuild src/renderer/app.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/app.js --sourcemap",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron . --no-sandbox",
    "dev": "npm run build && electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "totp-generator": "^1.0.1",
    "uuid": "^11.1.0"
  },
  "build": {
    "appId": "com.vaultx.app",
    "productName": "VaultX",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
